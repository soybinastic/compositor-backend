# Staging example — copy to .env.staging on the server (do not commit secrets).
# Load via: DOTENV_FILE=.env.staging  or systemd EnvironmentFile=.env.staging
#
# Port offsets assume a second mediasoup beside an existing one on the same host.
# Local development should keep using .env (4443 / 50000–50999).

# Django
SECRET_KEY=change-me-in-staging
DEBUG=False
ALLOWED_HOSTS=compositor-test.example.com,127.0.0.1

# Mediasoup SFU (offset ports — matches server/config.staging.mjs)
# API URL can be loopback; WS URL must be reachable by browsers.
MEDIASOUP_API_URL=http://127.0.0.1:5443
MEDIASOUP_ORIGIN=https://sfu-test.example.com
MEDIASOUP_WS_URL=wss://sfu-test.example.com

# Studio frontend (invite links)
STUDIO_FRONTEND_URL=https://studio-test.example.com

# RTP ingest — mediasoup pushes PlainTransport RTP here
COMPOSITOR_RTP_HOST=127.0.0.1
COMPOSITOR_RTP_PORT_MIN=52000
COMPOSITOR_RTP_PORT_MAX=52999
PRODUCER_POLL_INTERVAL=2

# Compositor output canvas
CANVAS_WIDTH=1920
CANVAS_HEIGHT=1080
CANVAS_FPS=30

# Prefer cpu on unknown staging GPUs; use auto/cuda when verified
COMPOSITOR_VIDEO_BACKEND=cpu
COMPOSITOR_CUDA_DEVICE_ID=-1
COMPOSITOR_DISABLE_BACKGROUND=false

# Recording / streaming paths (use absolute paths on the server)
RECORDINGS_DIR=./recordings
RECORDING_VIDEO_BITRATE=4000000
RECORDING_AUDIO_BITRATE=128000
RECORDING_EOS_TIMEOUT_SEC=5

STREAMING_HLS_DIR=./streams/hls
STREAMING_VIDEO_BITRATE=2500000
STREAMING_AUDIO_BITRATE=128000
STREAMING_EOS_TIMEOUT_SEC=5
DEFAULT_RTMP_URL=

WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SEC=5

STREAMING_RTMP_MAX_RECONNECT_ATTEMPTS=5
STREAMING_RTMP_RECONNECT_DELAY_SEC=3
GRACEFUL_SHUTDOWN_TIMEOUT_SEC=30
